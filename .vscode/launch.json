{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Run PWA",
            "webRoot": "${workspaceFolder}/",
            "runtimeArgs": [
                "--app=http://localhost:5173"
            ],
            "sourceMapPathOverrides": {
                "../../src": "${workspaceFolder}/src",
                "../../src/*": "${workspaceFolder}/src/*"
            },
            "preLaunchTask": "npm run dev-task",
            "postDebugTask": "postdebugKill"
        }
    ]
}
