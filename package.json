{
  "name": "beter-dan-de-midi",
  "version": "1.0",
  "description": "Een app speciaal voor Carlijn en Sander met muziek die gespeeld is op de bruiloft. 25 mei 2024",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev-server": "vite --open --host",
    "dev": "npm run dev-server",
    "dev-task": "vite",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "ci": "biome ci src",
    "deploy": "npx @azure/static-web-apps-cli login --no-use-keychain && npx @azure/static-web-apps-cli deploy",
    "build": "tsc --noEmit && vite build",
    "start": "npm run dev",
    "start-remote": "vite --host"
  },
  "author": "Imre Boersma",
  "license": "ISC",
  "dependencies": {
    "lit": "^3.3.3",
    "urlpattern-polyfill": "^10.1.0",
    "workbox-build": "^7.4.1",
    "workbox-core": "^7.0.0",
    "workbox-precaching": "^7.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^26.4.1",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "workbox-build": {
      "glob": "^11.0.0",
      "inflight": "npm:once@^1.4.0",
      "sourcemap-codec": "npm:@jridgewell/sourcemap-codec@^1.4.15",
      "ejs": "^6.0.1"
    }
  }
}
