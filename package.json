{
  "name": "beter-dan-de-midi",
  "version": "1.0",
  "description": "Een app speciaal voor Carlijn en Sander met muziek die gespeeld is op de bruiloft. 25 mei 2024",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev-server": "vite --open --host",
    "dev": "npm run dev-server",
    "dev-task": "vite",
    "lint": "eslint src",
    "deploy": "npx @azure/static-web-apps-cli login --no-use-keychain && npx @azure/static-web-apps-cli deploy",
    "build": "tsc && vite build",
    "start": "npm run dev",
    "start-remote": "vite --host"
  },
  "author": "Imre Boersma",
  "license": "ISC",
  "dependencies": {
    "lit": "^3.3.1",
    "urlpattern-polyfill": "^10.1.0",
    "workbox-build": "^7.4.0",
    "workbox-core": "^7.0.0",
    "workbox-precaching": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "globals": "^16.4.0",
    "terser": "^5.44.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vite-plugin-pwa": "^1.1.0"
  },
  "overrides": {
    "workbox-build": {
      "glob": "^11.0.0",
      "inflight": "npm:once@^1.4.0",
      "sourcemap-codec": "npm:@jridgewell/sourcemap-codec@^1.4.15"
    }
  }
}