{
  "name": "beter-dan-de-midi",
  "version": "1.0",
  "description": "Een app speciaal voor Carlijn en Sander met muziek die gespeeld is op de bruiloft. 25 mei 2024",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev-server": "vite --open --host",
    "dev": "npm run dev-server",
    "dev-task": "vite",
    "lint": "eslint src",
    "deploy": "npx @azure/static-web-apps-cli login --no-use-keychain && npx @azure/static-web-apps-cli deploy",
    "build": "tsc && vite build",
    "start": "npm run dev",
    "start-remote": "vite --host"
  },
  "author": "Imre Boersma",
  "license": "ISC",
  "dependencies": {
    "lit": "^3.3.1",
    "urlpattern-polyfill": "^10.1.0",
    "workbox-build": "^7.3.0",
    "workbox-core": "^7.0.0",
    "workbox-precaching": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.1",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "terser": "^5.44.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vite-plugin-pwa": "^1.0.3"
  }
}
